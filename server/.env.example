PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ingressoja
JWT_SECRET=change-this-to-a-long-random-string
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
MERCADOPAGO_ACCESS_TOKEN=TEST-your-test-access-token
MERCADOPAGO_CLIENT_ID=your-client-id
MERCADOPAGO_CLIENT_SECRET=your-client-secret
PLATFORM_FEE_PERCENT=8
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Segurança
# Chave de 32 bytes (base64) para criptografar os tokens do Mercado Pago no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Assinatura secreta do webhook (painel do Mercado Pago → Suas integrações → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# Saltos de proxy na frente do servidor (Render = 1); usado para o limite de tentativas por IP
TRUST_PROXY_HOPS=1

# Reservas / compras
RESERVATION_TTL_MINUTES=30
MAX_TICKETS_PER_PURCHASE=10
